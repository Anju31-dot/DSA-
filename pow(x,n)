class Solution {
    public double myPow(double x, int n) {
        long N =n;
        if(N<0){
            x=1/x;
            N=-N;
        }
        return fastpow(x,N);
       

    }
    public double fastpow(double x, long n){
        if(n==0) return 1;
        if(n==1) return x;
        if(n%2==0){
            return fastpow(x*x,n/2);
        }
        return x*fastpow(x,n-1);
    }

}
